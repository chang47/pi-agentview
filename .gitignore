# Ephemeral visual-test output. __golden__/ IS committed (the references); the
# per-run renders under __artifacts__/ are not.
test/visual/__artifacts__/

# NOTE: dist/ is deliberately COMMITTED.
# `pi install git:...` clones the repo and runs `npm install`, but it does not
# run our build script, so the bundled broker must already be in the tree or
# every git install would spawn brokers that don't exist.
